# Образец окружения для docker compose. Скопировать в `.env.local` и заполнить:
#
#     cp .env.local.example .env.local
#
# `.env.local` в репозиторий не идёт (`.gitignore`). Ключи наружу не выносим.
# Compose читает этот файл только с флагом: `docker compose --env-file .env.local ...`

# --- LLM: серверы школы, llama.cpp ------------------------------------------
LAKE_KEY_9B=
LAKE_KEY_35B=

# Адреса по умолчанию зашиты в `lake/llm.py`; эти две переменные их перебивают.
# Нужны, когда пул 9B делится со всей школой и стоит в очереди: массовые шаги
# уводятся на свободный сервер перезапуском, без пересборки образа. Ключ едет
# следом — `LAKE_KEY_9B` это ключ к тому серверу, куда смотрит `LAKE_URL_9B`.
#
#     LAKE_URL_9B=http://82.202.156.206:8080   # массовые шаги на 35B
#     LAKE_KEY_9B=<ключ 35B>
#
# LAKE_URL_9B=
# LAKE_URL_35B=

# --- Ключ к нашему API ----------------------------------------------------------
# Единственная аутентификация блока A. Каждая ручка либо пишет в граф, либо тратит
# GPU школы, поэтому сервер БЕЗ ключа не поднимается вовсе — пустая строка здесь
# это не «выключено», это отказ на старте. Сгенерировать:
#
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Клиент шлёт `Authorization: Bearer $LAKE_API_KEY`. Открыты без ключа только
# `/openapi.json` и `/docs` — это контракт интеграции, данных озера в нём нет.
LAKE_API_KEY=

# Очередь `POST /fetch` (`lake/queue.py`, `lake/api/workers.py`) — не влияют на
# `/ingest/phase1`/`/ingest/phase2`, у тех слот один и без очереди.
#
# Потоков пула фазы 1. Пул общий с остальной школой (16 слотов на 9B), поэтому
# это калибровочная ручка под чужую очередь, а не под своё CPU.
# LAKE_FETCH_WORKERS=2
#
# Потолок очереди: сколько заданий может быть queued/running/staged одновременно,
# прежде чем `/fetch` начнёт отвечать 429. Без потолка бэклог рос бы неограниченно —
# каждое принятое задание получало бы статус `queued`, до которого никто не дотянется.
# LAKE_QUEUE_MAX=100
#
# Пауза потоков пула и писателя между опросами пустой очереди, секунды.
# LAKE_QUEUE_POLL_S=1.0
#
# Писателя фазы 2 не настраивают: он ровно один на озеро (§4.5) и держит `flock` на
# `data/writer.lock`. Поэтому **один рабочий процесс** на один каталог данных: второй
# (`uvicorn --workers 2`, перекрывающий деплой, `python3 -m lake.ingest.run phase2` с
# хоста) получит отказ при старте, а не второго писателя.

# Адрес, на котором порт 8077 виден снаружи контейнера. По умолчанию 127.0.0.1 —
# ходить туннелем `ssh -N -L 8077:127.0.0.1:8077 user@host`. `0.0.0.0` открывает
# API в сеть: ключ обязателен и он есть, но TLS здесь нет и в заголовке он идёт
# открытым текстом.
# LAKE_BIND=0.0.0.0

# --- Данные озера -------------------------------------------------------------
# Каталог, который монтируется в контейнер как `lake/data`: озеро, индекс,
# staging, логи и трейсы. По умолчанию — `./lake/data`, там результаты прошлых
# живых прогонов. Для чистого прогона указать пустой каталог, а не удалять
# старый: тезисы добыты вызовами LLM и второй раз бесплатно не появятся.
#
# LAKE_DATA=./lake/data-fresh

# --- Граф ---------------------------------------------------------------------
# Единственный бэкенд — Neo4j (D11, `graph_client._select_backend()`). NEO4J_URI
# обязателен: не задан или пуст — отказ на старте, а не тихая запись в SQLite —
# того бэкенда в коде больше нет.
#
# Переход на этот compose на сервере, где данные ещё в старом `lake.db`:
# сначала операционно перелить их в Neo4j старым образом (как раньше, вручную,
# до выката), и только потом поднимать образ без stub — в его коде пути чтения
# из SQLite нет, недоперенесённые данные из него взять будет неоткуда.
#
# Локальная Neo4j в compose. Хост `neo4j` — имя сервиса,
# `bolt://` без TLS: трафик не выходит за пределы сети compose.
NEO4J_URI=bolt://neo4j:7687
# Локальный контейнер поднимается с `NEO4J_AUTH: none` и эти две строки
# игнорирует: драйверу нужна пара, серверу — нет. Порт открыт только на
# 127.0.0.1. Строки оставлены, чтобы переход на облако был правкой значений,
# а не структуры файла.
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=ignored-locally
# В Community-редакции база всегда одна и называется `neo4j`.
NEO4J_DATABASE=neo4j

# --- Облачный граф вместо локального ------------------------------------------
# Aura — база блока B, с их тестовыми узлами (`07:79`), не озеро A. Менять NEO4J_URI
# и соседей выше значит, что и работающий сервис `lake` пишет прямо в Aura —
# изоляции через отдельный бэкенд (`LAKE_STORE=stub`) больше нет (D11), делать это
# можно только по согласованию с B (`13` §4.4 п.1). Для одноразовой заливки в Aura
# эти четыре строки НЕ трогать — см. ниже.
#
# Одноразовая заливка в Aura БЕЗ переключения самого сервиса — отдельные
# NEO4J_TARGET_* переменные на разовом вызове (`lake/neo4j_load.py`), не правка
# NEO4J_URI выше и не правка этого файла. Две группы имён — не одна — потому что
# после D11 `NEO4J_URI` это ещё и то, что `neo4j_load.py` ЧИТАЕТ (через
# `graph_client`, локальное озеро): переиспользовать её же для ЗАПИСИ значило бы
# на время вызова направить и чтение в Aura тоже — `build()` прочитал бы (почти
# пустой) граф Aura и залил бы его сам в себя, а не локальное озеро в Aura
# (найдено при ревью, BLOCKER третьего раунда). Заливка отказывает сама, если
# NEO4J_TARGET_URI равен NEO4J_URI:
#
#   docker compose --env-file .env.local run --rm \
#     -e NEO4J_TARGET_URI=neo4j+s://<instance>.databases.neo4j.io \
#     -e NEO4J_TARGET_USERNAME=<instance> -e NEO4J_TARGET_PASSWORD=<pwd> \
#     -e NEO4J_TARGET_DATABASE=<instance> \
#     lake python -m lake.neo4j_load
#
# Имя базы у Aura — идентификатор инстанса, а НЕ `neo4j`: NEO4J_TARGET_DATABASE
# обязателен, значения по умолчанию нет — подключение без него ушло бы в пустой
# граф молча.
#
# `--wipe` требует переменной подтверждения LAKE_CONFIRM_WIPE, установленной точно на значение
# NEO4J_URI. Без неё любой вызов `--wipe` отказывает. Пример локального стирания:
#
#   LAKE_CONFIRM_WIPE=bolt://localhost:7687 python -m lake.neo4j_store --wipe
#
# `--wipe` поверх Aura (или любого не-локального NEO4J_TARGET_URI) отказывает
# всегда, независимо от этих переменных (`neo4j_store._require_local_target`,
# `07:79`) — снести чужую базу блока B одним флагом не должно быть возможно.
#
# NEO4J_TARGET_URI=neo4j+s://<instance>.databases.neo4j.io
# NEO4J_TARGET_USERNAME=<instance>
# NEO4J_TARGET_PASSWORD=
# NEO4J_TARGET_DATABASE=<instance>
